# Copy to tools/deploy.local.env (git-ignored) and fill in your server's values.
# Use the same values as the previous site's repo (it-tudes.tech/tools/deploy.local.env):
# this site replaces it in the same server folder.

# ssh alias (from ~/.ssh/config in WSL) and the hostname the server must report,
# so a deploy never lands on the wrong machine.
SSH_HOST=my-server
EXPECTED_HOST=my-server-hostname

# Where releases live on the server; mounted read-only into the proxy at /srv/it-tudes.
REMOTE_BASE=/home/deploy/sites/it-tudes

# The nginx container that terminates HTTPS (checked, never restarted).
CONTAINER=nginx

# Other apps behind the same proxy, checked after a deploy: "scheme path expected-status".
# Never create site pages under a path one of them owns.
OTHER_CHECKS="http /health 200
https /other-app/ 200"
