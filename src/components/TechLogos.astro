---
// Technology logos from Simple Icons, drawn in the current text colour.
import { siDotnet, siTypescript, siReact, siVuedotjs, siPostgresql, siDocker, siLinux, siOpenjdk, siNginx, siOnnx } from "simple-icons";

interface Props { label: string }
const { label } = Astro.props;
const logos = [siDotnet, siOpenjdk, siTypescript, siReact, siVuedotjs, siPostgresql, siDocker, siLinux, siNginx, siOnnx];
---
<section class="tech" aria-label={label}>
  <div class="container tech-inner">
    <p class="tech-label">{label}</p>
    <ul>
      {logos.map((l) => (
        <li title={l.title}>
          <svg viewBox="0 0 24 24" width="28" height="28" role="img" aria-label={l.title}><path d={l.path} fill="currentColor" /></svg>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tech { border-block: 1px solid var(--line); background: var(--surf); }
  .tech-inner { display: flex; align-items: center; gap: 24px 48px; padding-block: 28px; }
  .tech-label { font-size: .875rem; color: var(--mute); flex-shrink: 0; max-width: 16ch; line-height: 1.4; }
  ul { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 32px; flex: 1; list-style: none; margin: 0; padding: 0; color: var(--mute); }
  li { display: flex; transition: color .2s var(--ease); }
  li:hover { color: var(--ink); }
  @media (max-width: 767px) {
    .tech-inner { flex-direction: column; align-items: flex-start; }
    .tech-label { max-width: none; }
    ul { justify-content: flex-start; gap: 22px 28px; }
  }
</style>
