---
// Phosphor icon (regular weight), inlined at build time from @phosphor-icons/core.
import fs from "node:fs";
import path from "node:path";

interface Props { name: string; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
const file = path.join(process.cwd(), "node_modules/@phosphor-icons/core/assets/regular", `${name}.svg`);
const svg = fs.readFileSync(file, "utf8")
  .replace("<svg ", `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false"${cls ? ` class="${cls}"` : ""} `);
---
<Fragment set:html={svg} />
