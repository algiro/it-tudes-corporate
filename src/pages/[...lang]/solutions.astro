---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import BrandGraphic from "../../components/BrandGraphic.astro";
import CtaBand from "../../components/CtaBand.astro";
import { copy, solutionIds, type Lang } from "../../../content/site";
import { langPaths } from "../../i18n/utils";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const c = copy[lang];
---
<Base lang={lang} title={c.solutions.title} description={c.solutions.intro}>
  <PageHero title={c.solutions.title} lead={c.solutions.intro} seed={14} />

  <div class="container solutions-layout">
    <nav class="index" aria-label={c.solutions.title}>
      <ul>
        {solutionIds.map((id) => <li><a href={`#${id}`}><Icon name={c.solutions.items[id].icon} size={18} />{c.solutions.items[id].title}</a></li>)}
      </ul>
    </nav>
    <div class="solutions">
      {solutionIds.map((id, i) => {
        const s = c.solutions.items[id];
        const story = c.stories.items.find((st) => st.solution === id);
        return (
          <section class="solution" id={id} data-reveal>
            <div class="solution-head">
              <span class="solution-icon"><Icon name={s.icon} size={26} /></span>
              <h2>{s.title}</h2>
            </div>
            <p class="lead">{s.text}</p>
            <div class="solution-detail">
              <ul class="checks">{s.points.map((p) => <li><Icon name="check" size={18} />{p}</li>)}</ul>
              {story
                ? (
                  <div class="proof on-navy">
                    <div class="proof-art"><BrandGraphic variant="field" seed={20 + i} count={6} /></div>
                    <p class="proof-sector">{story.sector}</p>
                    <p class="proof-title">{story.title}</p>
                    <p class="proof-result">{story.result}</p>
                  </div>
                )
                : <div class="proof-art-only"><BrandGraphic variant="field" seed={20 + i} count={8} /></div>}
            </div>
          </section>
        );
      })}
    </div>
  </div>

  <CtaBand lang={lang} />
</Base>

<style>
  .solutions-layout { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: clamp(32px, 6vw, 88px); padding-block: var(--section); align-items: start; }
  .index { position: sticky; top: 104px; }
  .index ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; border-left: 2px solid var(--line); }
  .index a { display: flex; align-items: center; gap: 10px; padding: 10px 14px; margin-left: -2px; border-left: 2px solid transparent; text-decoration: none; color: var(--soft); font-size: .9375rem; transition: color .2s var(--ease), border-color .2s var(--ease); }
  .index a:hover { color: var(--ink); border-left-color: var(--accent); }
  .index a :global(svg) { color: var(--accent); flex-shrink: 0; }
  .solutions { display: grid; }
  .solution { display: grid; gap: 22px; padding-block: 48px; border-top: 1px solid var(--line); }
  .solution:first-child { padding-top: 0; border-top: 0; }
  .solution-head { display: flex; align-items: center; gap: 16px; }
  .solution-icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: var(--radius); background: var(--accent-soft); color: var(--accent); flex-shrink: 0; }
  .solution-head h2 { font-size: clamp(1.625rem, 2.6vw, 2.125rem); }
  .solution-detail { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; align-items: stretch; margin-top: 4px; }
  .proof { position: relative; overflow: hidden; display: grid; gap: 8px; align-content: end; min-height: 220px; padding: 24px; border-radius: var(--radius); background: linear-gradient(135deg, var(--navy), #0F2A62); }
  .proof-art { position: absolute; inset: 0 0 35% 30%; opacity: .7; }
  .proof > p { position: relative; }
  .proof-sector { font: 500 .75rem/1.3 var(--mono); text-transform: uppercase; letter-spacing: .04em; color: var(--on-navy-accent); }
  .proof-title { font-weight: 600; font-size: 1.125rem; color: var(--on-navy); }
  .proof-result { color: var(--on-navy-soft); font-size: .9375rem; }
  .proof-art-only { min-height: 200px; border-radius: var(--radius); overflow: hidden; background: var(--tint); }
  @media (max-width: 960px) {
    .solutions-layout { grid-template-columns: 1fr; }
    .index { position: static; }
    .index ul { grid-template-columns: 1fr 1fr; border-left: 0; gap: 8px; }
    .index a { border: 1px solid var(--line); border-radius: var(--radius); margin: 0; }
  }
  @media (max-width: 767px) {
    .solution-detail { grid-template-columns: 1fr; }
    .index ul { grid-template-columns: 1fr; }
  }
</style>
