---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import { site, copy, type Lang } from "../../../content/site";
import { langPaths } from "../../i18n/utils";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const c = copy[lang].contact;
---
<Base lang={lang} title={c.title}>
  <PageHero title={c.title} lead={c.intro} seed={23}>
    <a class="email" href={`mailto:${site.email}`}><Icon name="envelope-simple" size={26} />{site.email}</a>
  </PageHero>

  <section class="section">
    <div class="container contact-grid">
      <div data-reveal>
        <h2>{c.stepsTitle}</h2>
        <ol class="steps">{c.steps.map((s) => <li><span>{s}</span></li>)}</ol>
      </div>
      <div class="include" data-reveal style="--i:1">
        <h2>{c.includeTitle}</h2>
        <ul class="checks">{c.include.map((s) => <li><Icon name="check" size={18} />{s}</li>)}</ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .email { display: inline-flex; align-items: center; gap: 14px; margin-top: 12px; padding: 18px 24px; border: 1px solid rgb(255 255 255 / .22); border-radius: var(--radius); background: rgb(255 255 255 / .05); font-size: clamp(1.125rem, 2.4vw, 1.5rem); font-weight: 500; text-decoration: none; color: var(--on-navy); transition: border-color .25s var(--ease), background-color .25s var(--ease); max-width: 100%; overflow-wrap: anywhere; justify-self: start; }
  .email:hover { border-color: var(--on-navy-accent); background: rgb(255 255 255 / .09); }
  .email :global(svg) { color: var(--on-navy-accent); flex-shrink: 0; }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(40px, 6vw, 96px); align-items: start; }
  h2 { font-size: clamp(1.5rem, 2.4vw, 1.875rem); margin-bottom: 28px; }
  .steps { list-style: none; counter-reset: step; margin: 0; padding: 0; display: grid; gap: 0; }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 44px 1fr; gap: 16px; align-items: center; padding-block: 18px; border-top: 1px solid var(--line); color: var(--soft); font-size: 1.0625rem; }
  .steps li::before { content: counter(step); display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--radius); background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .include { padding: 28px; border-radius: var(--radius); background: var(--surf); border: 1px solid var(--line); }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
